# Copy to deploy/server/.env and fill in. Keep .env out of git.

# The hostname the server is reached at through your tunnel or reverse proxy (requests for other hostnames are refused). Comma-separated for several.
ARTEMIS_PUBLIC_HOSTS=artemis.example.com

# Only if the web app is hosted on another domain than the server itself.
# ARTEMIS_ALLOWED_ORIGINS=https://app.example.com

# Encrypts the provider keys and connector secrets stored on the server. Make a long random value once
# (openssl rand -base64 32), keep a copy somewhere safe: without it, stored keys cannot be read back.
ARTEMIS_MASTER_KEY=change-me

# Name shown in the apps.
ARTEMIS_SERVER_NAME=Home server

# Provider keys can also come from here instead of the apps: ARTEMIS_KEY_<PROVIDER_ID>=...
# ARTEMIS_KEY_OPENAI=sk-...

# For the optional cloudflared service in docker-compose.yml
# TUNNEL_TOKEN=
